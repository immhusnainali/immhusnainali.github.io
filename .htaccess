# Optional Apache helpers for mhusnain.online uploads.
# CORS needed so github.io can probe health + tools before redirecting.

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/health\.txt$" CORS_PROBE=1
  SetEnvIf Request_URI "^/tools/" CORS_PROBE=1
  Header set Access-Control-Allow-Origin "*" env=CORS_PROBE
  Header set Cache-Control "no-store, max-age=0" env=CORS_PROBE

  # Stop browsers keeping the old empty tools HTML after a bad upload.
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes
